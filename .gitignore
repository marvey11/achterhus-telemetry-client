# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# PyTest Code Coverage
.coverage
coverage.xml
htmlcov/

# Ignore all personal or tool-generated VS Code files
.vscode/*

# Allow-list shared team configurations
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Ignore local user overrides if created
.vscode/settings.local.json

.prompts
